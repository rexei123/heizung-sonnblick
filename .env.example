# Diese Datei als Vorlage in .env kopieren: cp .env.example .env

# --- Datenbank ---
POSTGRES_DB=heizung
POSTGRES_USER=heizung
POSTGRES_PASSWORD=heizung_dev
DATABASE_URL=postgresql+asyncpg://heizung:heizung_dev@db:5432/heizung

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Anwendung ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# In Produktion mit z. B. `openssl rand -hex 32` erzeugen:
SECRET_KEY=change-me-in-production

# --- Wetterdaten (Kaprun) ---
OPENMETEO_LATITUDE=47.272
OPENMETEO_LONGITUDE=12.753

# --- LoRaWAN (Sprint 5) ---
# MQTT-Credentials werden in Sprint 5.3 mit mosquitto_passwd erzeugt.
# In .env eintragen, nicht im Repo.
MQTT_HEIZUNG_PASSWORD=changeme
MQTT_CHIRPSTACK_PASSWORD=changeme

# ChirpStack-DB
CHIRPSTACK_DB_PASSWORD=chirpstack

# ChirpStack API-Secret (mind. 32 Zeichen, in Produktion via openssl rand -hex 32)
CHIRPSTACK_API_SECRET=please-change-this-secret-min-32-chars-long

# ChirpStack API-Key fuer Bootstrap-Skript (wird nach erstem Login in der UI generiert)
CHIRPSTACK_API_KEY=

# --- Belegungs-Import-Webhook (Sprint 15e) ---
# Shared Secret fuer den mailparser-Webhook (Header X-Webhook-Token).
# Mit `openssl rand -hex 32` erzeugen. Leer = Endpoint lehnt alles ab (401).
OCCUPANCY_IMPORT_TOKEN=
# Lokale Uhrzeit (Europe/Vienna), bis zu der die Tagesliste erwartet wird.
OCCUPANCY_IMPORT_EXPECTED_BY_LOCAL=09:00

# --- Batterie-Schwellen (Sprint 20b, AE-73) ---
# Grenzen der Batterie-Stufen in Volt, gerechnet auf dem 24-h-Median der
# Geraete-Spannung: ok ab BATTERY_OK_MIN_V, kritisch bis einschliesslich
# BATTERY_CRITICAL_MAX_V, dazwischen schwach.
# Keine Geheimnisse — die Vorgabewerte stehen hier bewusst ausgeschrieben,
# damit erkennbar ist, was ohne Eintrag gilt.
# Der Codec liefert nur 0,1-V-Schritte von 2,0 bis 3,5 V; Werte zwischen
# zwei Schritten verschieben nichts. CRITICAL_MAX muss unter OK_MIN liegen,
# sonst startet die API nicht.
BATTERY_OK_MIN_V=2.9
BATTERY_CRITICAL_MAX_V=2.6

# --- Ventil-Hinweise, Regel 3 und 3b (Sprint 20e, T7/T10) ---
# Zwei read-time abgeleitete Hinweise aus dem gleichen Fenster ueber
# sensor_reading:
#   Regel 3   Soll >= Ist + VALVE_STUCK_DELTA_K und Ventil <=
#             VALVE_STUCK_OPENNESS_MAX  ->  "Ventil pruefen"
#   Regel 3b  Ist >= Soll + ROOM_TOO_WARM_DELTA_K  ->  "Zimmer zu warm"
# Die Deltas sind absichtlich verschieden: der interne Vicki-Sensor wird von
# der Heizkoerperwaerme mitgezogen und verzerrt nur in Richtung 3b, also
# braucht diese Richtung mehr Abstand.
# Keine Geheimnisse; die Vorgabewerte stehen hier ausgeschrieben.
# Beide Deltas muessen > 0 sein, sonst startet die API nicht.
VALVE_STUCK_DELTA_K=3.0
VALVE_STUCK_OPENNESS_MAX=0
ROOM_TOO_WARM_DELTA_K=5.0
VALVE_WINDOW_H=2
