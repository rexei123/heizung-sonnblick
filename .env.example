# Diese Datei als Vorlage in .env kopieren: cp .env.example .env

# --- Datenbank ---
POSTGRES_DB=heizung
POSTGRES_USER=heizung
POSTGRES_PASSWORD=heizung_dev
DATABASE_URL=postgresql+asyncpg://heizung:heizung_dev@db:5432/heizung

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Anwendung ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# In Produktion mit z. B. `openssl rand -hex 32` erzeugen:
SECRET_KEY=change-me-in-production

# --- Wetterdaten (Kaprun) ---
OPENMETEO_LATITUDE=47.272
OPENMETEO_LONGITUDE=12.753

# --- LoRaWAN (Sprint 5) ---
# MQTT-Credentials werden in Sprint 5.3 mit mosquitto_passwd erzeugt.
# In .env eintragen, nicht im Repo.
MQTT_HEIZUNG_PASSWORD=changeme
MQTT_CHIRPSTACK_PASSWORD=changeme
# Das UG65-Gateway meldet sich mit eigenen Zugangsdaten an (Mosquitto-User
# `gateway-ug65`, RUNBOOK §10a.1/§10a.2). Diese Zeile fehlte hier bis zum
# 15.10.2026, obwohl §10a.1 sie setzt — gefunden beim Schreiben der
# Rotations-Anleitung (§10ab). Leer lassen; der Wert lebt nur in der `.env`
# auf dem Server.
MQTT_GATEWAY_UG65_PASSWORD=

# ChirpStack-DB
CHIRPSTACK_DB_PASSWORD=chirpstack

# ChirpStack API-Secret (mind. 32 Zeichen, in Produktion via openssl rand -hex 32)
CHIRPSTACK_API_SECRET=please-change-this-secret-min-32-chars-long

# ChirpStack API-Key fuer Bootstrap-Skript (wird nach erstem Login in der UI generiert)
CHIRPSTACK_API_KEY=

# --- Belegungs-Import-Webhook (Sprint 15e) ---
# Shared Secret fuer den mailparser-Webhook (Header X-Webhook-Token).
# Mit `openssl rand -hex 32` erzeugen. Leer = Endpoint lehnt alles ab (401).
OCCUPANCY_IMPORT_TOKEN=
# Lokale Uhrzeit (Europe/Vienna), bis zu der die Tagesliste erwartet wird.
OCCUPANCY_IMPORT_EXPECTED_BY_LOCAL=09:00

# --- Batterie-Schwellen (Sprint 20b, AE-73) ---
# Grenzen der Batterie-Stufen in Volt, gerechnet auf dem 24-h-Median der
# Geraete-Spannung: ok ab BATTERY_OK_MIN_V, kritisch bis einschliesslich
# BATTERY_CRITICAL_MAX_V, dazwischen schwach.
# Keine Geheimnisse — die Vorgabewerte stehen hier bewusst ausgeschrieben,
# damit erkennbar ist, was ohne Eintrag gilt.
# Der Codec liefert nur 0,1-V-Schritte von 2,0 bis 3,5 V; Werte zwischen
# zwei Schritten verschieben nichts. CRITICAL_MAX muss unter OK_MIN liegen,
# sonst startet die API nicht.
BATTERY_OK_MIN_V=2.9
BATTERY_CRITICAL_MAX_V=2.6

# --- Abstands-Waechter Belegungsliste (Sprint 23 T3) ---
# Der taegliche Waechter fragt "kam heute eine Liste?". Dieser fragt "wie
# lange ist die letzte her?" — er faengt den Fall, dass die Liste um 15:30
# ausfaellt und die Ampel trotzdem gruen bleibt.
#
# Leer (IMPORT_MAX_GAP_HOURS=) schaltet ihn ganz aus.
#
# Warum 8 und nicht 3: die Listen kommen um 08:30, 15:30 und 19:30, die
# regulaeren Abstaende sind also 7 h und 4 h. Eine Schwelle von 3 h haette
# jeden Tag um 11:31 angeschlagen. 8 faengt eine ausgefallene 15:30-Liste
# ab 16:31; eine ausgefallene 19:30-Liste faengt der taegliche Waechter am
# naechsten Morgen.
IMPORT_MAX_GAP_HOURS=8
# Das Versandfenster in Ortszeit. Der Abstand gilt nur darin — zwischen
# 19:30 und 08:30 liegen 13 Stunden, und die sind normal.
IMPORT_WINDOW_START_LOCAL=08:30
IMPORT_WINDOW_END_LOCAL=19:30

# --- Ventil-Hinweise, Regel 3 und 3b (Sprint 20e, T7/T10) ---
# Zwei read-time abgeleitete Hinweise aus dem gleichen Fenster ueber
# sensor_reading:
#   Regel 3   Soll >= Ist + VALVE_STUCK_DELTA_K und Ventil <=
#             VALVE_STUCK_OPENNESS_MAX  ->  "Ventil pruefen"
#   Regel 3b  Ist >= Soll + ROOM_TOO_WARM_DELTA_K  ->  "Zimmer zu warm"
# Die Deltas sind absichtlich verschieden: der interne Vicki-Sensor wird von
# der Heizkoerperwaerme mitgezogen und verzerrt nur in Richtung 3b, also
# braucht diese Richtung mehr Abstand.
# Keine Geheimnisse; die Vorgabewerte stehen hier ausgeschrieben.
# Beide Deltas muessen > 0 sein, sonst startet die API nicht.
VALVE_STUCK_DELTA_K=3.0
VALVE_STUCK_OPENNESS_MAX=0
ROOM_TOO_WARM_DELTA_K=5.0
VALVE_WINDOW_H=2
# --- Health-Altersschwellen (Sprint 20e, T6) ---
# Ab welchem Alter des juengsten Readings ein Geraet als degraded bzw.
# silent gilt, in Stunden. Der Funkstille-Alarm haengt an der zweiten
# Grenze — bis Sprint 20e stand sie auf 24 h, also rund 144 verpasste
# Keep-alives, bevor jemand eine Mail bekam.
# Keine Geheimnisse; die Vorgabewerte stehen hier ausgeschrieben.
# DEGRADED muss groesser als HEALTHY sein, sonst startet die API nicht.
# --- Regel 3b relativ (Sprint 20e-b, T3) ---
# 3b verlangt seit 20e-b ZWEI Bedingungen (UND): Ist ueber dem Sollwert
# (ROOM_TOO_WARM_DELTA_K, oben) UND Ist ueber vergleichbaren Zimmern. Das
# absolute Kriterium allein kann Wetter nicht von einem klemmenden Ventil
# unterscheiden — am 07.10.2026 meldete die Kachel 14 Geraete, echt waren 2.
#
# ROOM_REL_DELTA_K  Abstand zum Median der NICHT belegten Zimmer (Stufe 1)
# ROOM_REL_DELTA_ALL_K  Abstand zum Median ALLER Zimmer (Stufe 2, Hochsaison;
#                   groesser, weil Gaeste 22-24 Grad einstellen)
# REF_MIN_ROOMS     Mindestzahl Zimmer in der Referenzmenge; darunter gibt es
#                   kein relatives Urteil und damit keinen 3b-Hinweis
#
# Keine Geheimnisse; die Vorgabewerte stehen hier ausgeschrieben. Sie sind
# gemessen (T0 am 08.10.2026), nicht geschaetzt. ALL darf nicht kleiner als
# ROOM_REL_DELTA_K sein und REF_MIN_ROOMS nicht unter 3, sonst startet die
# API nicht.
ROOM_REL_DELTA_K=3.5
ROOM_REL_DELTA_ALL_K=4.0
REF_MIN_ROOMS=5
# --- Regel 3c "Ventil schliesst nicht" (Sprint 20e-c, T3) ---
# Ein funktionierendes Vicki schliesst, wenn das Zimmer ueber dem eigenen
# Sollwert liegt. Meldet es stattdessen zwei Stunden durchgehend ein weit
# offenes Ventil, arbeitet seine Regelung nicht.
#
# Die Regel vergleicht das Geraet mit SICH SELBST und ist damit
# saisonunabhaengig — anders als Regel 3b, die eine Referenz braucht.
#
# Gemessen am 10.10.2026: die beiden defekten Koepfe melden durchgehend
# 100 % bei 7,2 bzw. 6,1 K ueber dem Sollwert. Die Marken sitzen also nicht
# knapp.
#
# Keine Geheimnisse; die Vorgabewerte stehen hier ausgeschrieben.
# NOT_CLOSING_DELTA muss KLEINER als ROOM_TOO_WARM_DELTA_K sein und
# OPEN_MIN_PCT groesser als VALVE_STUCK_OPENNESS_MAX, sonst startet die API
# nicht.
VALVE_OPEN_MIN_PCT=80
VALVE_NOT_CLOSING_DELTA_K=2.0
HEALTH_HEALTHY_MAX_AGE_H=2
HEALTH_DEGRADED_MAX_AGE_H=3
# --- Rueckfallpunkt (Sprint 20g, H-6 T10) ---
# PIN_SHA wird NICHT hier gesetzt, sondern in infra/deploy/.env auf dem
# Server (RUNBOOK §10u, Schritt 3). Die Zeile steht hier, weil die
# Container dieselbe Datei als env_file bekommen und das Backend den Wert
# liest, um nach sieben Tagen an einen gesetzten Pin zu erinnern.
# Leer oder fehlend = kein Pin. Das Backend handelt nicht danach.
PIN_SHA=
